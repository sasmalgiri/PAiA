{
  "manifest_version": 3,
  "name": "PAiA — Privacy-first AI",
  "short_name": "PAiA",
  "version": "0.1.0",
  "description": "Right-click any selection or page to ask PAiA, your local-first AI assistant. Pairs with the PAiA desktop app over 127.0.0.1.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8744/*",
    "http://localhost:8744/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PAiA",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open PAiA quick input"
    }
  }
}
